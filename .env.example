# Copy to .env to change settings. Placeholders only; never commit real keys.

# Model endpoint: any OpenAI-compatible chat API. Default: local Ollama started by docker compose.
LLM_BASE_URL=http://ollama:11434/v1
# Open-weight model name. qwen3:4b is the default; qwen3:1.7b is faster on small laptops; qwen3:8b is better on bigger ones.
LLM_MODEL=qwen3:4b
# Ollama ignores this. Only set a real key (in .env, never committed) if you point LLM_BASE_URL at a free hosted tier.
LLM_API_KEY=local
# Seconds to wait for one model answer (CPU-only laptops can be slow).
LLM_TIMEOUT=900
# USD per 1k tokens, used for the cost-per-run figure. 0 for local models.
LLM_COST_IN_PER_1K=0
LLM_COST_OUT_PER_1K=0
# Where the decision log is written for CLI runs.
DECISION_LOG_PATH=decision_log.json
# Optional: override gate thresholds (JSON file).
GATES_CONFIG=config/gates.json
# How many fetched posts the Researcher reads per run (lower = faster on small laptops).
RESEARCH_MAX_SOURCES=24
# Where public research results are cached for 7 days.
RESEARCH_CACHE=runs/cache
# 1 = ask the server for JSON mode (works with Ollama; leave 0 for llama.cpp + Qwen3).
LLM_JSON_MODE=0
# Optional: file where unparseable model answers are written for debugging. Empty = off.
LLM_DEBUG_FILE=

# Optional fast free tier (open-weight GPT-OSS 120B). Uncomment and put YOUR OWN key in .env (never commit it):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=your-free-groq-key-here
